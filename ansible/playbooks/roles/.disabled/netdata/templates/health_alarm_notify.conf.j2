# Netdata Health Notifications Configuration
# Generated by Ansible - Do not edit manually

###############################################################################
# Sending Notifications

# Email notifications
{% if netdata_email_notifications %}
SEND_EMAIL="YES"
DEFAULT_RECIPIENT_EMAIL="{{ netdata_email_recipient }}"
{% else %}
SEND_EMAIL="NO"
{% endif %}

# Discord notifications (disabled by default)
SEND_DISCORD="NO"
DISCORD_WEBHOOK_URL=""

# Slack notifications (disabled by default)
SEND_SLACK="NO"
SLACK_WEBHOOK_URL=""

# Telegram notifications (disabled by default)
SEND_TELEGRAM="NO"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# PagerDuty notifications (disabled by default)
SEND_PD="NO"
PD_SERVICE_KEY=""

###############################################################################
# Role Definitions

# Role check results
# WHO SHOULD GET THE EMAIL?
role_recipients_email[sysadmin]="{{ netdata_email_recipient }}"
role_recipients_email[domainadmin]="{{ netdata_email_recipient }}"
role_recipients_email[dba]="{{ netdata_email_recipient }}"
role_recipients_email[webmaster]="{{ netdata_email_recipient }}"
role_recipients_email[proxyadmin]="{{ netdata_email_recipient }}"
role_recipients_email[sitemgr]="{{ netdata_email_recipient }}"

###############################################################################
# Images in notifications

# Set this to YES to include images in email notifications
EMAIL_SENDER="{{ netdata_email_recipient }}"
EMAIL_CHARSET="UTF-8"
IMAGES_IN_EMAIL="YES"
