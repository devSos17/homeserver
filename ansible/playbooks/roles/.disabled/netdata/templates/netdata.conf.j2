# Netdata Configuration
# Generated by Ansible - Do not edit manually
# Date: {{ ansible_date_time.iso8601 }}

[global]
    # Runtime settings
    run as user = netdata
    
    # Web server settings
    bind to = {{ netdata_web_bind_to }}
    default port = {{ netdata_web_port }}
    
    # Memory mode
    memory mode = dbengine
    page cache size = {{ netdata_dbengine_page_cache_size }}

[db]
    # Storage engine
    mode = dbengine
    
    # Tier 0: Per-second resolution
    storage tiers = 3
    dbengine multihost disk space = {{ netdata_dbengine_tier0_disk_space }}
    
    # Update every (seconds)
    update every = 1

[ml]
    # Machine Learning
    enabled = {{ 'yes' if netdata_enable_ml else 'no' }}

[health]
    # Health monitoring
    enabled = {{ 'yes' if netdata_enable_health else 'no' }}

[web]
    # Web dashboard
    web files owner = root
    web files group = netdata
    
    # Enable gzip compression
    enable gzip compression = yes

[logs]
    # Logging
    debug log = /var/log/netdata/debug.log
    error log = /var/log/netdata/error.log
    access log = /var/log/netdata/access.log
    
    # Log level
    level = {{ netdata_log_level }}

[plugins]
    # Enable all plugins
    proc = yes
    diskspace = yes
    cgroups = yes
    tc = yes
    idlejitter = yes
    apps = yes
    charts.d = yes
    node.d = yes
    python.d = yes
    go.d = yes
    
    # Container monitoring
    cgroups = yes
    
[plugin:proc]
    # Enable /proc monitoring
    /proc/net/dev = yes
    /proc/diskstats = yes
    /proc/mdstat = yes
    /proc/net/snmp = yes
    /proc/net/netstat = yes
    /proc/net/stat/conntrack = yes
    /proc/net/ip_vs/stats = yes
    /proc/stat = yes
    /proc/meminfo = yes
    /proc/vmstat = yes
    /proc/net/rpc/nfsd = yes
    /proc/sys/kernel/random/entropy_avail = yes
    /proc/pressure = yes
    /proc/interrupts = yes
    /proc/softirqs = yes
    /proc/loadavg = yes
    /proc/sys/fs/file-nr = yes
    /proc/sys/net/netfilter/nf_conntrack_count = yes

[plugin:apps]
    # Process monitoring
    update every = 1
    command options = 

[plugin:cgroups]
    # Container monitoring (Docker, LXC, systemd services)
    update every = 1
    check for new cgroups every = 10
    enable running cgroup = yes
    enable cpuacct stat = yes
    enable cpuacct usage = yes
    enable memory = yes
    enable detailed memory = yes
    enable memory limits = yes
    enable swap memory = yes
    enable blkio bandwidth = yes
    enable blkio operations = yes
    enable blkio throttle bandwidth = yes
    enable blkio throttle operations = yes
    enable blkio queued operations = yes
    enable blkio merged operations = yes

[plugin:tc]
    # Network QoS monitoring
    script to run to get tc values = /usr/libexec/netdata/plugins.d/tc-qos-helper.sh

[plugin:idlejitter]
    # CPU idlejitter monitoring
    loop time in ms = 20
